# Template for the git-ignored `.env` at the repo root. Copy it, fill in the
# keys you need, and never commit the copy — `.gitignore` refuses `.env` and
# lets only this file through.
#
# Nothing here ships. The app's own Supabase publishable key is a compile-time
# default in lib/services/supabase.dart, and every real backend secret lives in
# Supabase Function secrets. These two are developer tooling that runs on a
# laptop.

# tool/icon_gen — generates the missing grocery icons. See its README.
GEMINI_API_KEY=
