  "strings": {
    "Ausgabe erfassen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabe erfassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a spend"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registar despesa"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar gasto"
          }
        }
      },
      "comment": "The action's name in Shortcuts and Spotlight. This is the string the setup steps in lib/l10n tell the user to look for (spendWalletStep4) — change one and change the other, or the instructions name an action that is not there."
    },
    "Speichert eine Apple-Pay-Zahlung in Aporah. Am besten mit einer Kurzbefehl-Automation „Transaktion\" verbinden.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert eine Apple-Pay-Zahlung in Aporah. Am besten mit einer Kurzbefehl-Automation „Transaktion\" verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves an Apple Pay payment to Aporah. Best paired with a Shortcuts “Transaction” automation."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda um pagamento Apple Pay no Aporah. Funciona melhor com uma automação “Transação” nos Atalhos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un pago con Apple Pay en Aporah. Funciona mejor con una automatización “Transacción” en Atajos."
          }
        }
      }
    },
